[managers]
manager ansible_host=192.168.56.10 ansible_ssh_private_key_file=~/.ssh/vagrant_manager

[workers]
worker-01 ansible_host=192.168.56.11 ansible_ssh_private_key_file=~/.ssh/vagrant_worker01
worker-02 ansible_host=192.168.56.12 ansible_ssh_private_key_file=~/.ssh/vagrant_worker02

[swarm:children]
managers
workers

[all:vars]
ansible_user=vagrant
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
